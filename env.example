# Email Configuration Example
# Copy this file to .env and update with your credentials

# Gmail Configuration (Recommended)
# 1. Enable 2FA on your Google account
# 2. Generate App Password: Google Account > Security > App passwords
# 3. Use the 16-character app password (remove spaces)
GMAIL_SENDER_EMAIL=your-agent@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Outlook/Hotmail Configuration
# 1. Enable 2FA on your Microsoft account  
# 2. Generate App Password in Security settings
OUTLOOK_SENDER_EMAIL=your-agent@outlook.com
OUTLOOK_APP_PASSWORD=your-outlook-app-password

# Custom SMTP Configuration
CUSTOM_SMTP_SERVER=smtp.yourcompany.com
CUSTOM_SMTP_PORT=587
CUSTOM_SENDER_EMAIL=agent@yourcompany.com
CUSTOM_SMTP_PASSWORD=your-smtp-password

# Default sender for sendmail (if using system sendmail)
DEFAULT_SENDER_EMAIL=agent@localhost

# Security Settings
EMAIL_DEBUG=false