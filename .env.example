# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=mystocks
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
CACHE_TTL=3600

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Performance Configuration
MAX_WORKERS=10
TASK_TIMEOUT=300
MAX_FILE_SIZE=16777216

# Security Configuration (add these for production)
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs (if needed)
ALPHA_VANTAGE_API_KEY=your_api_key
FINNHUB_API_KEY=your_api_key

# Monitoring (optional)
PROMETHEUS_ENABLED=false
LOG_LEVEL=INFO

# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Autonomous Agents
NEWS_RECIPIENT_EMAIL=your_email@example.com
NEWS_SERVER_URL=http://localhost:5000/v1

# Social Media Plugins (Optional - for testing)
TWITTER_TEST_API_KEY=your_twitter_api_key
TWITTER_TEST_API_SECRET=your_twitter_api_secret
TWITTER_TEST_ACCESS_TOKEN=your_twitter_access_token
TWITTER_TEST_ACCESS_SECRET=your_twitter_access_secret
SUBSTACK_TEST_EMAIL=your_substack_email@example.com
MEDIUM_TEST_INTEGRATION_TOKEN=your_medium_integration_token