def main():
    """Main CLI entry point"""
    parser = argparse.ArgumentParser(
        description="Server Logs Management CLI",
        add_help=False  # We'll handle help ourselves
    )

    # Add subcommands
    parser.add_argument('command', nargs='?', default='help',
                       choices=['status', 'enable', 'disable', 'level', 'requests', 'timing',
                               'save', 'reset', 'restore', 'monitor', 'help'])
    parser.add_argument('args', nargs='*', help='Command arguments')

    if len(sys.argv) == 1:
        show_help()
        return

    args = parser.parse_args()

    # Route commands
    if args.command == 'help':
        show_help()
    elif args.command == 'status':
        show_status()
    elif args.command == 'enable':
        enable_logging()
    elif args.command == 'disable':
        disable_logging()
    elif args.command == 'level':
        if not args.args:
            print_error("Please specify a log level")
            print_info("Usage: ./server_logs level <DEBUG|INFO|WARNING|ERROR|CRITICAL>")
        else:
            set_level(args.args[0])
    elif args.command == 'requests':
        if not args.args:
            print_error("Please specify 'on' or 'off'")
            print_info("Usage: ./server_logs requests <on|off>")
        else:
            toggle_requests(args.args[0])
    elif args.command == 'timing':
        if not args.args:
            print_error("Please specify 'on' or 'off'")
            print_info("Usage: ./server_logs timing <on|off>")
        else:
            toggle_timing(args.args[0])
    elif args.command == 'save':
        save_current_settings()
    elif args.command == 'reset':
        reset_to_defaults()
    elif args.command == 'restore':
        restore_persistent_settings()
    elif args.command == 'monitor':
        monitor_logs()

if __name__ == "__main__":
    main()